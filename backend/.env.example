# ─── Production Environment (.env) ───
# Copy this to .env and fill in actual values before deploying

PORT=5000

# MongoDB Atlas connection string (replace with your production cluster)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.XXXXX.mongodb.net/shopflow?retryWrites=true&w=majority

# JWT secret — use a strong, random string in production (min 32 chars)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# AI / Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Stripe Secret Key (use live key for production, test key for staging)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Environment
NODE_ENV=production

# Frontend URL (for CORS & email links)
CLIENT_URL=https://your-frontend-domain.vercel.app
